{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug FastAPI Project backend: Python Debugger",
            "type": "debugpy",
            "request": "launch",
            "module": "uvicorn",
            "args": [
                "app.main:app",
                "--reload",
                "--port",
                "8000"
            ],
            "cwd": "${workspaceFolder}/backend",
            "python": "${workspaceFolder}/.venv/bin/python",
            "jinja": true,
            "envFile": "${workspaceFolder}/.env",
            "preLaunchTask": "Docker: Postgres"
        },
        {
            "type": "chrome",
            "request": "launch",
            "name": "Debug Frontend: Launch Chrome against http://localhost:5173",
            "url": "http://localhost:5173",
            "webRoot": "${workspaceFolder}/frontend/src",
            "preLaunchTask": "Frontend: Vite dev"
        }
    ],
    "compounds": [
        {
            "name": "Debug Full Stack: Backend + Frontend",
            "configurations": [
                "Debug FastAPI Project backend: Python Debugger",
                "Debug Frontend: Launch Chrome against http://localhost:5173"
            ],
            "stopAll": true
        }
    ]
}
