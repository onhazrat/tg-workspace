# =============================================================================
# TG Summarizer — Environment Variables
# =============================================================================
#
# MODE A (hardened single-operator)
# ---------------------------------
# This project targets a self-hosted deployment for one operator — not a
# multi-tenant SaaS. A single superuser owns all data; public signup is off in
# production. Per-user row scoping (Mode B) is deferred.
#
# See: docs/migration/DECISIONS.md, development.md § "Mode A deployment"
#
# LOCAL DEV vs PRODUCTION
# -----------------------
# Copy this file to `.env` and adjust for your environment.
#
#   Local dev (defaults below):
#     ENVIRONMENT=local
#     USERS_OPEN_REGISTRATION=true   — convenient signup at /signup
#     SECRET_KEY=changethis          — placeholder OK for local only
#     API_KEY=                       — optional; scripts may omit X-API-Key
#     TOKEN_ENCRYPTION_KEY=          — optional; backend uses dev fallback
#
#   Production (Mode A — required):
#     ENVIRONMENT=production
#     USERS_OPEN_REGISTRATION=false  — no public signup; use bootstrap superuser
#     SECRET_KEY=<strong-random>       — must not be "changethis"
#     API_KEY=<generate-random>        — required; scripts send X-API-Key header
#     TOKEN_ENCRYPTION_KEY=<fernet>    — required for bot token encryption at rest
#     VITE_API_KEY=<same-as-API_KEY>   — build-time key for scripts/CI only
#
# Staging follows production rules for TOKEN_ENCRYPTION_KEY; API_KEY is required
# when ENVIRONMENT=production (see backend config validation).
# =============================================================================


# --- Core ---

# Production: set via deploy env / GitHub secrets
DOMAIN=localhost
# Local Traefik subdomain testing:
# DOMAIN=localhost.tiangolo.com

# Used by the backend to generate links in emails to the frontend
FRONTEND_HOST=http://localhost:5173
# Staging/production example:
# FRONTEND_HOST=https://dashboard.example.com

# local | staging | production
# Use `local` for native dev and Docker Compose on your machine.
ENVIRONMENT=local

PROJECT_NAME="TG Summarizer"
STACK_NAME=tg-summarizer


# --- Auth & Mode A ---

# JWT signing secret. Replace in staging/production — never use "changethis".
SECRET_KEY=changethis

# JWT access token lifetime (minutes). Default: 8 days.
ACCESS_TOKEN_EXPIRE_MINUTES=11520

# Password-reset email token lifetime (hours).
EMAIL_RESET_TOKEN_EXPIRE_HOURS=48

# Bootstrap superuser created on first startup (idempotent; password not overwritten).
FIRST_SUPERUSER=admin@example.com
FIRST_SUPERUSER_PASSWORD=changethis

# Public signup at /signup.
#   local dev:  true  — convenient for testing new accounts
#   production: false — required for Mode A (single operator, no open registration)
USERS_OPEN_REGISTRATION=true

# Script/CI authentication (X-API-Key header). Browser UI uses JWT instead.
#   local dev:  optional
#   production: required (Mode A)
API_KEY=

# Bot token encryption at rest (Fernet key, separate from SECRET_KEY).
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#   local dev:  optional — backend uses a dev-only fallback when empty
#   staging/production: required
TOKEN_ENCRYPTION_KEY=

# Allowed browser origins (comma-separated). Update for your production domain.
BACKEND_CORS_ORIGINS="http://localhost,http://localhost:5173,https://localhost,https://localhost:5173,http://localhost.tiangolo.com"


# --- Email ---

SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=
EMAILS_FROM_EMAIL=info@example.com
SMTP_TLS=True
SMTP_SSL=False
SMTP_PORT=587


# --- Database ---

POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=app
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changethis

# Dev API database name (keep `app`; do not set POSTGRES_DB to app_test).
# Isolated database for backend pytest — never point tests at dev `app`.
# One-time setup: createdb app_test && alembic upgrade head (see development.md)
POSTGRES_DB_TEST=app_test


# --- Observability ---

SENTRY_DSN=


# --- Docker (CI/CD) ---

# Override in CI/CD for your registry
DOCKER_IMAGE_BACKEND=backend
DOCKER_IMAGE_FRONTEND=frontend


# --- TG Summarizer — AI & scraping ---

GEMINI_API_KEY=

TOR_ENABLED=false
TOR_CONTROL_PASSWORD=
TOR_CONTROL_PORT=9051
TOR_SOCKS_PROXY=socks5h://127.0.0.1:9050
DEFAULT_PROXY_URLS=
EMBEDDING_MODEL=gemini-embedding-2-preview
DEFAULT_AI_MODEL=gemini-3-flash-preview


# --- Sync & scraping ---

# Default parallel channel syncs (AppSetting bootstrap; UI can override).
SYNC_CONCURRENCY_DEFAULT=3
# Per-channel scrape retries on rate-limit / network errors.
SYNC_MAX_RETRIES=3
# Exponential backoff base (ms) between sync retries.
SYNC_RETRY_BACKOFF_BASE_MS=2000
# Scheduler poll interval for auto-sync staleness checks (seconds).
AUTO_SYNC_CHECK_INTERVAL_SECONDS=60
# Default auto-sync interval when no AppSetting exists (minutes).
AUTO_SYNC_INTERVAL_MINUTES_DEFAULT=60
# Pause auto-sync after consecutive failures (milliseconds).
AUTO_SYNC_PAUSE_DURATION_MS=600000
# Minimum failure count before auto-sync pauses (also capped by channel count).
AUTO_SYNC_FAILURE_THRESHOLD_MIN=3
# Max posts fetched per channel per scrape pass.
SCRAPER_MAX_POSTS_PER_CHANNEL=300
# Max pagination iterations per channel scrape.
SCRAPER_ITERATION_LIMIT=15


# --- Background jobs (scheduler intervals) ---

EMBEDDINGS_JOB_INTERVAL_SECONDS=60
AUTO_SUMMARY_JOB_INTERVAL_SECONDS=60
RETENTION_JOB_INTERVAL_HOURS=6
TRANSLATION_BATCH_JOB_INTERVAL_SECONDS=30

# Default enabled state for scheduler jobs when no jobs AppSetting row exists yet.
# Embeddings backfill and translation batch are off by default to avoid unexpected API usage.
JOBS_EMBEDDINGS_ENABLED_DEFAULT=false
JOBS_AUTO_SYNC_ENABLED_DEFAULT=true
JOBS_AUTO_SUMMARY_ENABLED_DEFAULT=true
JOBS_RETENTION_ENABLED_DEFAULT=true
JOBS_TRANSLATION_BATCH_ENABLED_DEFAULT=false


# --- Embeddings ---

# Posts embedded per API batch during backfill.
EMBEDDINGS_CHUNK_SIZE=20
# Default limit for /rag/embed and scheduler backfill runs.
EMBEDDINGS_BACKFILL_LIMIT_DEFAULT=100


# --- Retention (AppSetting bootstrap) ---

RETENTION_POST_DAYS_DEFAULT=90
RETENTION_LOG_DAYS_DEFAULT=30


# --- Translation batch job ---

TRANSLATION_BATCH_LIMIT=20
TRANSLATION_BATCH_MAX_CHARS=4000
TRANSLATION_TARGET_LANGUAGE_DEFAULT=English


# --- RAG / vector search ---

# Hard cap on embeddings scanned per search request.
RAG_SCAN_LIMIT_MAX=5000
# Default result count for /rag/search.
RAG_SEARCH_LIMIT_DEFAULT=20
# Default limit for /rag/embed.
RAG_EMBED_LIMIT_DEFAULT=100


# --- Network / HTTP ---

# Proxy cooldown after network failure (milliseconds).
NETWORK_PROXY_COOLDOWN_MS=600000
# Retries for Telegram web-view scraping (fetch_with_retry defaults).
NETWORK_FETCH_RETRIES=8
NETWORK_FETCH_INITIAL_DELAY_MS=3000
NETWORK_FETCH_TIMEOUT_SECONDS=60
NETWORK_TOR_ROTATION_THRESHOLD=10
# Retries for Telegram Bot API calls (publish, bot info).
TELEGRAM_API_RETRIES=3
TELEGRAM_API_INITIAL_DELAY_MS=2000


# --- Sync job progress (SSE + persistence) ---

# Max interval between SSE snapshots when only postsFetched changes (ms)
SYNC_JOB_SSE_THROTTLE_MS=1000
# Flush in-memory sync job state to Postgres at most this often during scraping (ms)
SYNC_JOB_PERSIST_INTERVAL_MS=5000


# --- Frontend (Vite build-time) ---

# Leave empty for local dev — Vite proxies /api to localhost:8000
VITE_API_URL=

# Same value as API_KEY; embedded at build time for scripts/CI (not browser JWT auth)
VITE_API_KEY=

# Client-side sync job timeout before auto-cancel (ms). Default: 30 minutes.
VITE_SYNC_JOB_TIMEOUT_MS=1800000
# Polling interval when SSE is unavailable (ms). Default: 1 second.
VITE_SYNC_JOB_FALLBACK_POLL_MS=1000
# Embedding backfill status poll interval (ms).
VITE_RAG_STATUS_POLL_MS=10000
# Backend health-check poll interval (ms).
VITE_API_HEALTH_POLL_MS=30000
# Hover/batch translation debounce (ms).
VITE_TRANSLATION_DEBOUNCE_MS=1000
# Max characters per client-side translation batch.
VITE_TRANSLATION_MAX_BATCH_CHARS=4000
# Default auto-sync interval shown in settings (minutes; mirrors backend bootstrap).
VITE_AUTO_SYNC_INTERVAL_DEFAULT=60
# Default AI model / language in settings UI (mirrors DEFAULT_AI_MODEL).
VITE_DEFAULT_AI_MODEL=gemini-3-flash-preview
VITE_DEFAULT_AI_LANGUAGE=English
# React Query stale time for summarizer server state (ms).
VITE_QUERY_STALE_TIME_MS=30000
# Minimum interval between GET /sync-meta etag checks (ms). Default: 5 seconds.
VITE_SYNC_META_MIN_INTERVAL_MS=5000


# --- Traefik dashboard (compose.traefik.yml only) ---

# USERNAME=admin
# PASSWORD=changethis
# HASHED_PASSWORD=$(openssl passwd -apr1 $PASSWORD)
# EMAIL=admin@example.com
